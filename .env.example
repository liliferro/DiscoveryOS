# El informe de cuestionarios predefinidos conserva proveedores simulados.
PROVIDER_MODE=mock
DEMO_PASSWORD=discovery-demo
APP_BASE_URL=http://127.0.0.1:3000
# Alternativa a guardar una clave por empresa desde Integraciones.
# Mantener las claves solamente en .env.local, nunca en NEXT_PUBLIC_*.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Selección explícita, sin fallback automático entre proveedores.
AI_PROVIDER=openai
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Necesario si la clave de Anthropic no está asociada a un workspace.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Nube: Vercel activa este modo automáticamente. En local es optativo.
# DISCOVERY_STORAGE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Necesario para persistencia; nunca usar NEXT_PUBLIC_ aquí.
SUPABASE_SECRET_KEY=
# Opcional: clave base64 de 32 bytes para guardar claves por tenant.
# Sin esta variable, la IA usa las claves gestionadas en Vercel.
# APP_ENCRYPTION_KEY=
# DISCOVERY_NAMESPACE=production
